# ============================================================
# SR_GAME_CHINESE — 仓库忽略规则
# 原则：忽略规则只作用于「会产生构建产物的地方」，即 Projects/。
#       Archives/ 是留档区，其内容一律入库（原样保存，便于日后追溯）。
# ============================================================

# ---- 版本控制 / IDE ----
.vs/
*.suo
*.ipch
*.vsidx

# ---- 构建产物（仅 Projects 下）----
Projects/**/x64/
Projects/**/Debug/
Projects/**/Release/
Projects/**/*.obj
Projects/**/*.pch
Projects/**/*.tlog
Projects/**/*.lastbuildstate
Projects/**/*.FileListAbsolute.txt
Projects/**/*.recipe
Projects/**/*.asi
Projects/**/*.dll
Projects/**/*.pdb
Projects/**/*.lib
Projects/**/*.exp
Projects/**/*.ilk
Projects/**/*.log

# ---- NuGet 还原产物（packages.config 驱动，clone 后 restore 自动回来）----
Projects/**/packages/
*.nupkg

# ---- Python ----
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# ---- 工作区记忆（个人笔记，不分发）----
.workbuddy/

# ---- 根目录临时/调试产物（构建脚本、探针、崩溃分析中间文件）----
/_build*.py
/_peek.py
/_vq.py
/_probe/
/_probe_*.py
/_tmp_archive_*/
/_loose_bak/
/_*.txt
/_*.log
/_*.json
/Release/

# ---- data/：必须入库！----
# ★★ 2026-09-21 更正：原先这里是 `/data/`（整个目录排除），错。
#
#   data/{game}/{version}/misc/*_us.le_strings 是从游戏本体提取的 **_us 模板**，
#   是 build_release_le_strings.py 构建汉化 le_string 的**必需输入**。
#   它被 gitignore 之后，CI 全新 clone 拿不到 —— le_strings 步骤静默产出 0 个文件，
#   三个 target 全挂，白跑 6 分半才报一句"未产出任何 .le_strings"。
#
#   注意：不能靠 `!data/**` 之类的负向规则补救 —— git 的规则是
#   **「被排除的目录"内部"的路径无法通过 `!` 重新纳入」**。
#   所以正确做法就是**不要排除 data/ 本身**（下面只排除它的构建输出子目录）。
#
#   该目录实测约 76 MB / 660 文件，是发布构建的硬依赖，入库是唯一稳妥的供给方式。
/data/SR3/common/misc/_build/
/data/SR4/common/misc/_build/
/data/SR4/microsoft/misc/_build/

# ---- 发布构建产物（build_release.py / CI 生成，不入库）----
# 内容全部可由源材料 + 工具链重建；入库只会带来巨大的二进制噪音。
/release/

# ---- CI 发布说明的「中间产物」（workflow 生成，仅供本 run 内使用）----
# release_notes.md / commits.md 由 publish job 的「生成 Release 说明」步骤产出，
# 只用于喂给 gh api 作 body、不需要存档；一旦忽略漏配，每次跑完 CI 仓库根目录
# 都会冒出未跟踪文件，容易被误 git add 入库。
/release_notes.md
/commits.md

# ---- 校对工具链的中间产物 ----
# 校对流程会产生大量可重新生成的报告/快照/复核包：跑一次就出一份，
# 入库只会污染历史，且数 MB 的 CSV 没有留存价值。
#
# ⚠ gitignore 规则**自上而下首次匹配即生效**。要「忽略目录内某子目录、
#   但保留同级的另一个文件」，不能写 `/reports/` + `!` 反向（`!` 会连带
#   放行子目录），必须**用精确路径**逐条声明。
#
# ★★ 另一个坑：**行尾注释（`#`）不被 gitignore 支持**！
#   写成 `/reports/baseline/# 说明` 会被整行当成 pattern，规则**静默失效**
#   （v1 实测踩过：check-ignore 返回 not-ignored）。注释必须单独占一行。
/reports/baseline/
/.tmp_lint/
/.tmp_work/
/.tmp_w/
*.lint.json
*.review.jsonl

# 校对资产与审计凭据，必须入库：
#   - glossary.csv         术语表（L2 校验的依据）
#   - Documents/校对/      修复单、裁决清单、方案文档
#   - reports/fix_log.csv  修复留痕（时间/文件/行/旧值/新值/来源），
#     ★ 缺了它就无法追溯「到底改了哪几条、为什么改」，是回滚与复核的唯一凭据。

# ---- 例外：Archives 留档区一律保留 ----
!Archives/**
!**/.gitkeep
