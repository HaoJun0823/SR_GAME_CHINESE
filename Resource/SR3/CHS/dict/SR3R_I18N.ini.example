; SR3R_I18N 配置（与 SR3R_I18N.asi 同目录; UTF-8）
; v7.4 早期整句替换版: 语言服务返回层整句替换 (lang_early=1), 引擎布局自行按 CJK 切行
; dict_dir / origin_dir 均为可选 - 目录缺失时自动进入 font-only 模式(内置字符集), 可直接删除
; dict_dir   = 词典文件夹（相对本目录; 可选, 仅调试文本替换时使用）
; origin_dir = 联表文件夹（相对本目录; 可选）
; font_file  = 中文字体 TTF 文件名（相对本目录; 需 TrueType, 建议思源黑体 HW SC）
; dump_enabled = 是否收集未命中文本到 DumpText.dtxt（内核汉化后无意义, 建议 0）
; lang_early = 语言服务(sub_140812060/040)返回层整句替换（默认 1; 命中词典的完整句
;              提前换中文, 引擎自切行 -> 换行字幕不再依赖 wrap-rejoin 状态机）
; early_diag = 诊断日志（默认 1; 记录早期替换命中/Format 调用点归类, 验证完可设 0）
; subtitle_early = 字幕绘制入口(sub_1402D2BC0)整句替换（默认 1; 折行前换中文整句,
;              引擎按 CJK 宽度自然折行 -> 语音字幕长句不再漏译）
; charlist_file = 字符清单文件名（相对本目录; 可选, 缺省即 charlist.txt;
;              合并官方简体 le_data 用字 -> 补齐词典外的缺字如"齿";
;              文件不存在时仅日志提示, 不影响运行）

[settings]
dict_dir = dict
origin_dir = origin
font_file = SourceHanSansHWSC-VF.ttf
charlist_file = charlist.txt
dump_enabled = 1
lang_early = 1
early_diag = 1
subtitle_early = 1
